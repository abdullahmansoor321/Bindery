 generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// Supabase-managed identity table. Only the fields our app actually
/// touches are kept here — Prisma still sees the real table via `@@map`
/// is not needed since the model name already matches; we've simply
/// stopped generating types for the ~20 other Supabase auth tables
/// (sessions, MFA, SSO, OAuth, WebAuthn, etc.) we never query directly.
model users {
  instance_id                 String?   @db.Uuid
  id                          String    @id @db.Uuid
  aud                         String?   @db.VarChar(255)
  role                        String?   @db.VarChar(255)
  email                       String?   @unique(map: "users_email_partial_key", where: raw("(is_sso_user = false)")) @db.VarChar(255)
  encrypted_password          String?   @db.VarChar(255)
  email_confirmed_at          DateTime? @db.Timestamptz(6)
  created_at                  DateTime? @db.Timestamptz(6)
  updated_at                  DateTime? @db.Timestamptz(6)
  raw_app_meta_data            Json?
  raw_user_meta_data           Json?
  is_sso_user                  Boolean  @default(false)
  deleted_at                   DateTime? @db.Timestamptz(6)
  is_anonymous                 Boolean  @default(false)

  memberships                 memberships[]
  pages                       pages[]
  profiles                    profiles?
  search_logs                 search_logs[]
  workspaces                  workspaces[]

  @@index([email], map: "idx_users_email")
  @@schema("auth")
}

model memberships {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String          @db.Uuid
  workspace_id String          @db.Uuid
  role         membership_role
  created_at   DateTime        @default(now()) @db.Timestamptz(6)
  users        users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces   workspaces      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, workspace_id], map: "memberships_user_workspace_unique")
  @@index([user_id], map: "idx_memberships_user_id")
  @@index([workspace_id], map: "idx_memberships_workspace_id")
  @@schema("public")
}

model page_chunks {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id      String                @db.Uuid
  workspace_id String                @db.Uuid
  content      String
  embedding    Unsupported("vector")
  chunk_index  Int
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  pages        pages                 @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces   workspaces            @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([page_id, chunk_index], map: "page_chunks_page_chunkindex_unique")
  @@index([embedding], map: "idx_page_chunks_embedding_hnsw")
  @@index([page_id], map: "idx_page_chunks_page_id")
  @@index([workspace_id], map: "idx_page_chunks_workspace_id")
  @@schema("public")
}

model pages {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String        @db.Uuid
  parent_id      String?       @db.Uuid
  title          String
  content        Json          @default("{}")
  is_public      Boolean       @default(false)
  position       Float         @default(0)
  last_edited_by String?       @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  page_chunks    page_chunks[]
  users          users?        @relation(fields: [last_edited_by], references: [id], onUpdate: NoAction)
  pages          pages?        @relation("pagesTopages", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_pages    pages[]       @relation("pagesTopages")
  workspaces     workspaces    @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_id], map: "idx_pages_parent_id")
  @@index([id], map: "idx_pages_public", where: raw("(is_public = true)"))
  @@index([workspace_id], map: "idx_pages_workspace_id")
  @@index([workspace_id, parent_id], map: "idx_pages_workspace_parent")
  @@schema("public")
}

model profiles {
  id                       String      @id @db.Uuid
  avatar_url               String?
  display_name             String?
  last_active_workspace_id String?     @db.Uuid
  created_at               DateTime    @default(now()) @db.Timestamptz(6)
  users                    users       @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces               workspaces? @relation(fields: [last_active_workspace_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

model search_logs {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id       String     @db.Uuid
  user_id            String?    @db.Uuid
  query              String
  answer_summary     String?
  retrieved_page_ids String[]   @default([]) @db.Uuid
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  users              users?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  workspaces         workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_search_logs_user_id")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_search_logs_workspace_created")
  @@schema("public")
}

model workspaces {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  owner_id    String        @db.Uuid
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  memberships memberships[]
  page_chunks page_chunks[]
  pages       pages[]
  profiles    profiles[]
  search_logs search_logs[]
  users       users         @relation(fields: [owner_id], references: [id], onUpdate: NoAction)

  @@index([owner_id], map: "idx_workspaces_owner_id")
  @@schema("public")
}

enum membership_role {
  OWNER
  EDITOR
  VIEWER

  @@schema("public")
}
